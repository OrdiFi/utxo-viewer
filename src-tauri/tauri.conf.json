{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrdiFi UTXO Viewer",
  "version": "1.0.1",
  "identifier": "io.ordifi.utxoviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OrdiFi UTXO Viewer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/ordifi/32x32.png",
      "icons/ordifi/128x128.png",
      "icons/ordifi/128x128@2x.png",
      "icons/ordifi/icon.icns",
      "icons/ordifi/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
